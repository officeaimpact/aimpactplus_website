# Lead routing — все значения опциональны, без них API работает в preview-режиме
# (логирует заявку в server console и ничего не теряет).
#
# Web3Forms — основной канал доставки заявок на email. Получатель письма
# определяется НА СТОРОНЕ web3forms.com и привязан к access_key, поэтому:
#   1. Зарегистрируйтесь в https://web3forms.com под адресом lids@aimpact.ru
#   2. Создайте Access Key — он сразу будет привязан к этому email
#   3. Скопируйте ключ в NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY ниже
#   4. (Опционально) включите BCC/CC в дашборде на office@aimpact.ru
#
# Free-план Web3Forms принимает запросы только из браузера, поэтому ключ
# отправляется на клиент через NEXT_PUBLIC_*. Это безопасно: ключ — это
# публичный идентификатор формы, не секрет (защита от спама — на их стороне).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRM_WEBHOOK_URL=
LEADS_FALLBACK_EMAIL=lids@aimpact.ru

# Аналитика (Iter 4)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=

# Окружение
NEXT_PUBLIC_SITE_URL=https://xn----ntbbabzzpj.xn--p1ai
